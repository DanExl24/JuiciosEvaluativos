Enum estado_aprendiz_enum {
  "retiro voluntario"
  "en formacion"
  "traslado"
}

Enum estado_formacion_enum {
  "en ejecucion"
  "finalizada"
  "cancelada"
}

Enum fase_nombre_enum {
  ANALISIS
  PLANEACION
  EJECUCION
  EVALUACION
}

Enum juicio_estado_enum {
  aprobado
  desaprobado
  "por evaluar"
}

Enum modalidad_enum {
  presencial
  virtual
  "a distancia"
}

Table aprendiz {
  id_aprendiz int [pk, increment]
  documento varchar(20)
  tipo_documento varchar(20)
  nombres varchar(100)
  apellidos varchar(100)
  estado estado_aprendiz_enum
  id_formacion int

  indexes {
    (documento, id_formacion) [unique]
  }
}

Table competencia {
  id_competencia int [pk, increment]
  codigo varchar(50)
  nombre text
  id_programa int

  indexes {
    (codigo, id_programa) [unique]
  }
}

Table fases {
  id_fase int [pk, increment]
  nombre fase_nombre_enum
  actividad text
  id_programa int

  indexes {
    (nombre, id_programa) [unique]
  }
}

Table fase_competencia {
  id_fase int
  id_competencia int

  indexes {
    (id_fase, id_competencia) [pk]
  }
}

Table fase_resultado {
  id_fase int
  id_resultado int

  indexes {
    (id_fase, id_resultado) [pk]
  }
}

Table formacion {
  id_formacion int [pk, increment]
  ficha_caracterizacion varchar(100) [unique]
  estado estado_formacion_enum
  modalidad modalidad_enum
  id_programa int
}

Table funcionario {
  id_funcionario int [pk, increment]
  documento varchar(20) [unique]
  tipo_documento varchar(20)
  nombre varchar(100)
  apellido varchar(100)
}

Table juicios_evaluativos {
  id_juicio int [pk, increment]
  id_resultado int
  id_aprendiz int
  estado juicio_estado_enum [default: "por evaluar"]
  fecha timestamp
  id_funcionario int

  indexes {
    (id_resultado, id_aprendiz) [unique]
  }
}

Table programa {
  id_programa int [pk, increment]
  nombre text
  codigo varchar(50) [unique]
  version varchar(20)
}

Table proyecto_formativo {
  id_proyecto int [pk, increment]
  codigo_proyecto varchar(50) [unique]
  nombre text
  tiempo_ejecucion varchar(100)
  regional varchar(100)
  centro_formacion varchar(200)
  id_programa int [unique]
}

Table resultados_aprendizaje {
  id_resultado int [pk, increment]
  codigo varchar(50)
  detalle text
  id_competencia int

  indexes {
    (codigo, id_competencia) [unique]
  }
}

/* RELACIONES */

Ref: aprendiz.id_formacion > formacion.id_formacion

Ref: competencia.id_programa > programa.id_programa

Ref: fases.id_programa > programa.id_programa

Ref: formacion.id_programa > programa.id_programa

Ref: proyecto_formativo.id_programa > programa.id_programa

Ref: resultados_aprendizaje.id_competencia > competencia.id_competencia

Ref: fase_competencia.id_fase > fases.id_fase
Ref: fase_competencia.id_competencia > competencia.id_competencia

Ref: fase_resultado.id_fase > fases.id_fase
Ref: fase_resultado.id_resultado > resultados_aprendizaje.id_resultado

Ref: juicios_evaluativos.id_aprendiz > aprendiz.id_aprendiz
Ref: juicios_evaluativos.id_resultado > resultados_aprendizaje.id_resultado
Ref: juicios_evaluativos.id_funcionario > funcionario.id_funcionario